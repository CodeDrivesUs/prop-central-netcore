@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@using prop_central_netcore.Shared.Configuration

<link href="~/css/animate.css" rel="stylesheet" />
<style>
    .testimomialImage {
        height: 145px;
        max-width: 145px;
        border-radius: 70px;
        min-width: 145px;
    }

    .benefits {
        height: 170px;
        width: 170px;
        border-radius: 50px;
    }
</style>
<div class="slider_area">
    <div style="background-image:url('../../Content/Images/deborah-cortelazzi-gREquCUXQLI-unsplash.jpg'); background-size:cover; background-repeat:no-repeat; height:450px;">
        <div class="wrappers">
            <h2 class="text-center"> Housing The Next <br /> <span class="displa"></span></h2>

        </div>
    </div>
</div>
<!-- slider_area_end -->
<!-- where_togo_area_start  -->
<div class="where_togo_area">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-3">
                <div class="form_area">
                    <h3>Where you want to go?</h3>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="search_wrap">
                    <form class="search_form" action="/Home/FindFlat" method="post">

                        <div class="input_field">
                            <select id="City" name="City">
                                <option data-display="">City/Town</option>

                                <option value="Durban">Durban</option>

                            </select>
                        </div>
                        <div class="input_field">
                            <select name="Search" required>
                                <option data-display="">Surbub</option>
                                @foreach (var item in Model.indexViewModel.Surbubs)
                                {
                                    <option value="@item.Name">@item.Name</option>
                                }
                            </select>

                        </div>

                        <div class="input_field">

                            <select>
                                <option data-display="Room Type"></option>
                                @foreach (var item in Model.indexViewModel.RoomTypes)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="search_btn">
                            <button class="boxed-btn4 " type="submit">Search</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- where_togo_area_end  -->
<!-- popular_destination_area_start  -->
<div class="popular_destination_area">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section_title text-center mb_70">
                    <h3>Popular Locations</h3>
                    <p>Below is a list of flat locations that are visited by Students</p>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.indexViewModel.PopularPlaces)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="single_destination">
                        <div class="thumb">
                            <img src="@AppSettings.PhotoBaseUrl@item.ImageUrl" height="240" alt="">
                        </div>
                        <div class="content">
                            <p class="d-flex align-items-center">@item.PlaceName <a href="/Home/PopularPlace/?placeId=@item.Id"> <span>@item.NumberOfFlats </span> Flats</a> </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- popular_destination_area_end  -->
<!-- newletter_area_start  -->
<!-- newletter_area_end  -->

<div class="popular_places_area">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section_title text-center mb_70">
                    <h3>Popular Flats</h3>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model.indexViewModel.LatestFlats)
            {

                <div class="col-lg-4 col-md-6">
                    <div class="single_place">
                        <div class="thumb">

                            <img src="@AppSettings.PhotoBaseUrl@item.ImageUrl" alt="" height="240">
                            <a href="/Home/ViewFlat/?FlatId=@item.Id" class="prise">R @item.RentingPrice</a>
                        </div>
                        <div class="place_info">
                            <a href="/Home/ViewFlat/?FlatId=@item.Id"><h3>@item.AliasName </h3></a>
                            <p><i class="fa fa-map-marker text-danger"></i> @item.Surbub </p>
                            <div class="rating_days d-flex justify-content-between">
                                <span class="d-flex justify-content-center align-items-center">
                                    <i class="fa fa-star"></i>
                                    <a href="#">4.5</a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }


        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="more_place_btn text-center">
                    <a class="boxed-btn4" href="/home/FindFlat">More Flats</a>
                </div>
            </div>
        </div>
    </div>
</div>


