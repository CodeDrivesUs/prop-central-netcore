<div class="travel_variation_area">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="single_travel text-center">
                    <div class="icon">
                        <img class="benefits" src="~/Content/Images/Benefits/undraw_studying_re_deca.svg" alt="">
                    </div>
                    <h3>Comfortable Flats</h3>
                    <p>Find flats that are comfortable to students</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single_travel text-center">
                    <div class="icon">
                        <img class="benefits" src="~/Content/Images/Benefits/undraw_exams_g-4-ow.svg" alt="">
                    </div>
                    <h3>Study Zone</h3>
                    <p>Our flats have study zones so that students can study</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single_travel text-center">
                    <div class="icon">
                        <img class="benefits" src="~/Content/Images/Benefits/undraw_select_house_qbag.svg" alt="">
                    </div>
                    <h3>Closer to institution</h3>
                    <p>Find flats that are closer to institution</p>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- testimonial_area  -->
<div class="testimonial_area">
    <div class="container">
        <div class="row">
            <div class="col-xl-12">
                <div class="testmonial_active owl-carousel">
                    <div class="single_carousel">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="single_testmonial text-center">
                                    <div class="author_thumb">
                                        <img src="~/Content/Images/Testimonials/Liam.jpeg" alt="" class="testimomialImage">
                                    </div>
                                    <p>"I found a flat that is convenient for Students and at a very cheap renting price"</p>
                                    <div class="testmonial_author">
                                        <h3>Liam Forbay</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="single_carousel">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="single_testmonial text-center">
                                    <div class="author_thumb">
                                        <img src="~/Content/Images/Testimonials/Caps.jpeg" class="testimomialImage" alt="">
                                    </div>
                                    <p>"I Still can not beleave that a found a flat without having to search the whole town for flats"</p>
                                    <div class="testmonial_author">
                                        <h3>Simphiwe Hlophe</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="single_carousel">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="single_testmonial text-center">
                                    <div class="author_thumb">
                                        <img src="~/Content/Images/Testimonials/sentle.jpeg" class="testimomialImage" alt="">
                                    </div>
                                    <p>"Using the Prop-CentralSA website to search for a flat is simple and easy, all you have to do is to make a booking and got to your flat"</p>
                                    <div class="testmonial_author">
                                        <h3>Sentle Maboee</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
